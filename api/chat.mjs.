
export default async function handler(req, res) {
  if (req.method !== "POST") {
    res.setHeader("Allow", "POST");
    return res.status(405).json({
      error: "Use POST to send a message."
    });
  }

  try {
    const apiKey = process.env.GROQ_API_KEY;

    if (!apiKey) {
      return res.status(500).json({
        error: "GROQ_API_KEY is not configured in Vercel."
      });
    }

    const message = req.body?.message;

    if (typeof message !== "string" || !message.trim()) {
      return res.status(400).json({
        error: "Please enter a message."
      });
    }

    const result = await fetch(
      "https://api.groq.com/openai/v1/chat/completions",
      {
        method: "POST",
        headers: {
          "Authorization": `Bearer ${apiKey}`,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          model: "llama-3.3-70b-versatile",
          messages: [
            {
              role: "system",
              content: "You are Misha AI, a friendly, helpful personal AI assistant. Answer clearly and politely."
            },
            {
              role: "user",
              content: message.trim()
            }
          ]
        })
      }
    );

    const raw = await result.text();
    let data;

    try {
      data = JSON.parse(raw);
    } catch {
      return res.status(502).json({
        error: "Groq returned an invalid response."
      });
    }

    if (!result.ok) {
      return res.status(502).json({
        error: data.error?.message || "Groq request failed."
      });
    }

    const reply = data.choices?.[0]?.message?.content;

    if (!reply) {
      return res.status(502).json({
        error: "Groq returned no reply."
      });
    }

    return res.status(200).json({ reply });

  } catch (error) {
    console.error("Misha AI error:", error);
    return res.status(500).json({
      error: "Backend error. Check Vercel function logs."
    });
  }
}
